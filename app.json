{
  "expo": {
    "name": "Docentify",
    "slug": "docentify-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/docentify-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/docentifyminilogo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "docentify.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/docentifyminilogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/docentify-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F6F6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a0942609-bdaf-4c5b-a58f-32ea6dd7506e"
      }
    },
    "owner": "thenamesgiu"
  }
}
